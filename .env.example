# 招标雷达 — 环境变量样例
# 复制为 .env 后按需修改。所有项都有默认值，不配也能跑。

# ── 数据库 ────────────────────────────────────────────
# 业务库：招标数据 + 采集状态。默认 SQLite（data/tender.db，零运维）
# 生产可切 PostgreSQL：
# TR_DATABASE_URL=postgresql://tender:tender@127.0.0.1:5432/tender
#
# 账号库：用户 / 会话 / 验证码 / 埋点。默认 data/auth.db，与业务库分开。
# 分开是为了不让采集的长写事务把登录卡死（SQLite 写锁是整库一把）。
# 切 PostgreSQL 时不用拆，留空即自动沿用上面的地址。
# TR_AUTH_DATABASE_URL=sqlite:////opt/tender-radar/data/auth.db

# ── 调度 ──────────────────────────────────────────────
TR_SCHEDULER_ENABLED=true
TR_SCHEDULER_INTERVAL_MIN=120
TR_CRAWL_ON_STARTUP=false

# ── 采集参数 ──────────────────────────────────────────
# 限速（秒）。政务站点脆弱，不要低于 1，建议 2–5。
TR_MIN_DELAY=2.0
TR_MAX_DELAY=5.0
TR_TIMEOUT=25
TR_MAX_RETRIES=3
TR_MAX_PAGES=5
# 是否允许降级到无头浏览器
TR_BROWSER_FALLBACK=true

# ── 浏览器内核 ────────────────────────────────────────
# auto     = 自动探测本机 Chrome / Edge（推荐，省掉 150MB 下载）
# bundled  = 用 playwright 自带的 Chromium（容器内用这个）
# none     = 不启用浏览器（纯 HTTP，ccgp 这类站会直接抓不到）
TR_BROWSER_CHANNEL=auto
# 指定具体的浏览器可执行文件路径（优先级最高，一般不用设）
# Windows: C:/Program Files/Google/Chrome/Application/chrome.exe
# Linux:   /usr/bin/google-chrome
# TR_BROWSER_PATH=

# ── LLM 兜底抽取（可选，默认关闭）──────────────────────
# 开启后仅对规则没抽到的字段调用，能显著提升央企/国企自由排版公告的召回
TR_LLM_FALLBACK=false
TR_LLM_BASE_URL=https://api.deepseek.com
TR_LLM_API_KEY=
TR_LLM_MODEL=deepseek-chat

# ── 账号与登录 ────────────────────────────────────────
# 管理员邮箱，逗号分隔，小写。这些账号登录后可见「管理」后台，其余一律普通用户。
# ⚠️ 部署前**必须改成你自己的邮箱**：照抄样例值等于把后台交给别人。
TR_ADMIN_EMAILS=you@example.com

# 登录态有效期（天）
TR_SESSION_DAYS=7

# 数据接口是否强制登录。
#   true  未登录一律 401（默认，公网部署必须保持 true）
#   false 数据接口完全开放，不登录也能读全部招标数据，仅本地调试用
# 注意：值后面不要再跟 `# 注释`，历史上这里就因为这个把 true 解析成了 false。
TR_REQUIRE_LOGIN=true

# ── SMTP：邮箱验证码登录 ──────────────────────────────
# 登录方式是「邮箱收 6 位验证码」，不设密码。六项里 HOST/USER/PASS 三个
# 必须填，缺任一个就降级成开发模式：验证码只写日志、并由接口回显给前端。
# 公网部署请务必配好——开发模式等于门禁形同虚设，启动时会有告警。
TR_CODE_TTL=600
TR_CODE_INTERVAL=60
TR_SMTP_HOST=smtp.exmail.qq.com
TR_SMTP_PORT=465
TR_SMTP_SSL=true
TR_SMTP_USER=
TR_SMTP_PASS=
TR_MAIL_FROM=
#
# 上面是**腾讯企业邮箱**的参数。换服务商时改这三行：
#   QQ 个人邮箱   smtp.qq.com              465 true   授权码（设置→账户里生成）
#   163 网易      smtp.163.com             465 true   授权码（设置里生成）
#   Gmail        smtp.gmail.com            465 true   应用专用密码（需先开 2FA）
#   Outlook      smtp-mail.outlook.com     587 false  微软已禁基本认证，不推荐
#
# 腾讯企业邮箱有三道开关，缺一不可，卡住时按这个顺序查：
#   1) 管理员后台：企业微信管理端 → 协作 → 邮件 → 安全管理 → 客户端访问权限，
#      把你的邮箱放进 POP/SMTP 或 IMAP/SMTP 的允许范围。
#      **这一步最容易被漏**，个人在网页端怎么点都开不了服务。
#   2) 网页端：登录 exmail.qq.com → 设置 → 收发信设置 → 开启服务，
#      勾上「开启 IMAP/SMTP 服务」和「开启 POP/SMTP 服务」→ 保存。
#   3) 密码：设置 → 邮箱绑定 → 客户端专用密码。
#      没开安全登录就用邮箱登录密码；开了安全登录必须用客户端专用密码，
#      填登录密码会报 535 认证失败。

# 跨域：前端由后端同源托管，默认留空（不启用 CORS）。
# 前后端分离部署才需要填，逗号分隔写全来源，不要用 *：
# TR_CORS_ORIGINS=https://tender.example.com

# ── 启动时显示的对外地址 ──────────────────────────────
# 云服务器（华为云/阿里云/腾讯云）的公网 IP 是 NAT 映射的，网卡上只有
# 172.16.x / 10.x / 192.168.x 这类私网地址，程序查不到自己的公网 IP。
# 默认会自动问外部接口探一次（约 1 秒，失败就跳过）。
# 不想探测就设 TR_PUBLIC_IP_LOOKUP=false；想写死就直接填 TR_PUBLIC_HOST。
# TR_PUBLIC_HOST=123.60.186.131
# TR_PUBLIC_IP_LOOKUP=true

# ── 收费（预留，暂未接入支付）──────────────────────────
TR_BILLING_ENABLED=false

# ── 告警与订阅 ────────────────────────────────────────
TR_NOTIFY_ENABLED=false
# 企业微信 / 飞书 / Slack 机器人 webhook 均可
TR_NOTIFY_WEBHOOK=
TR_NOTIFY_FAIL_THRESHOLD=3

# 关键词订阅，逗号分隔。命中后推送。
TR_WATCH_KEYWORDS=法律服务,法律顾问,诉讼代理
